rules_version = '2';

// Pequeños Atletas — reglas de seguridad (SPEC §2, RNF-01, §7.7).
// El entrenador es el usuario con rol 'entrenador'. Un padre solo ve los
// documentos donde su uid está en acudientesIds.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function esEntrenador() {
      return autenticado() && get(/databases/$(database)/documents/usuarios/$(uid())).data.rol == 'entrenador';
    }
    function esAcudiente(data) { return autenticado() && uid() in data.acudientesIds; }
    function acudienteDeNino(ninoId) {
      return autenticado() && uid() in get(/databases/$(database)/documents/ninos/$(ninoId)).data.acudientesIds;
    }
    function soloCambia(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    match /usuarios/{usuarioId} {
      allow read: if uid() == usuarioId || esEntrenador();
      allow create: if uid() == usuarioId && request.resource.data.rol == 'padre' && request.resource.data.estado == 'activo';
      allow update: if esEntrenador()
        || (uid() == usuarioId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'estado', 'correo']));
    }

    match /ninos/{ninoId} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      // Inscripción hecha por el padre (RF-P06/P07): queda pendiente, sin categoría ni cobro.
      allow create: if esEntrenador() || (
        autenticado()
        && request.resource.data.estado == 'pendiente_aprobacion'
        && request.resource.data.acudientesIds == [uid()]
        && !('categoriaId' in request.resource.data)
        && !('descuento' in request.resource.data)
        && !('fechaInscripcion' in request.resource.data));
      // Mientras está pendiente, el padre puede completar fotos y documentos de su propia solicitud.
      allow update: if esEntrenador() || (
        esAcudiente(resource.data)
        && resource.data.estado == 'pendiente_aprobacion'
        && soloCambia(['fotoRuta', 'documentos', 'seguroMedico', 'actualizadoEn']));
      allow delete: if false;
    }

    match /categorias/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    match /sesiones/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    match /pruebas/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    match /plantillasControl/{id} {
      allow read, write: if esEntrenador();
    }

    match /mediosPago/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    match /eventos/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    match /anuncios/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    match /configuracion/{id} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }

    // Datos por niño: solo lectura para el padre, escritura del entrenador.
    match /asistencias/{id} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      allow write: if esEntrenador();
    }
    match /medicionesFisicas/{id} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      allow write: if esEntrenador();
    }
    match /pagos/{id} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      allow write: if esEntrenador();
    }
    match /resultadosPruebas/{id} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      // CA-08: sin autorización de uso de imagen no se adjuntan fotos ni videos.
      allow write: if esEntrenador() && (
        request.resource.data.medios.size() == 0
        || get(/databases/$(database)/documents/ninos/$(request.resource.data.ninoId)).data.consentimientos.usoImagen.autorizado == true);
    }

    match /confirmacionesEvento/{id} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      allow create, update: if esEntrenador() || (
        acudienteDeNino(request.resource.data.ninoId)
        && request.resource.data.respondidoPor == uid()
        && request.resource.data.respuesta in ['asistira', 'no_asistira']);
    }

    // CA-07: el padre propone; el dato no cambia hasta que el entrenador aprueba.
    match /solicitudesCambio/{id} {
      allow read: if esEntrenador() || esAcudiente(resource.data);
      allow create: if acudienteDeNino(request.resource.data.ninoId)
        && request.resource.data.solicitadoPor == uid()
        && request.resource.data.estado == 'pendiente';
      allow update: if esEntrenador();
    }

    match /invitaciones/{id} {
      allow read: if esEntrenador() || (autenticado() && (resource.data.invitadoPor == uid() || resource.data.correo == request.auth.token.email));
      allow create: if esEntrenador() || autenticado()
        && request.resource.data.invitadoPor == uid()
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.ninosIds.size() > 0
        && request.resource.data.ninosIds.size() <= 5
        && acudienteDeNino(request.resource.data.ninosIds[0]);
      allow delete: if esEntrenador() || (autenticado() && resource.data.invitadoPor == uid());
    }

    match /notificaciones/{id} {
      allow read: if autenticado() && resource.data.usuarioId == uid();
      allow update: if autenticado() && resource.data.usuarioId == uid() && soloCambia(['leida']);
      allow create: if esEntrenador();
    }
  }
}
