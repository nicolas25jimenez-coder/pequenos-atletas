{
  "name": "pequenos-atletas",
  "private": true,
  "version": "0.1.0",
  "description": "App de seguimiento deportivo infantil · Pequeños Atletas",
  "workspaces": [
    "shared",
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app",
    "seed": "tsx scripts/seed.ts",
    "build": "npm run build -w app",
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p app --noEmit",
    "build:app": "npm run build -w app",
    "test:seguridad": "vitest run --config vitest.seguridad.config.ts"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "^2.1.8"
  }
}
