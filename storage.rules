rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function autenticado() { return request.auth != null; }
    function esEntrenador() {
      return autenticado() && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'entrenador';
    }
    function nino(ninoId) { return firestore.get(/databases/(default)/documents/ninos/$(ninoId)).data; }
    function acudiente(ninoId) { return autenticado() && request.auth.uid in nino(ninoId).acudientesIds; }
    function archivoValido(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Foto de perfil y documentos del niño (identidad, carné, certificado médico).
    match /ninos/{ninoId}/{archivo=**} {
      allow read: if esEntrenador() || acudiente(ninoId);
      allow write: if esEntrenador() || (acudiente(ninoId) && nino(ninoId).estado == 'pendiente_aprobacion' && archivoValido(5));
    }

    // Fotos y videos de resultados: solo con autorización de uso de imagen (CA-08, RNF-03).
    match /resultados/{ninoId}/{archivo=**} {
      allow read: if esEntrenador() || acudiente(ninoId);
      allow write: if esEntrenador()
        && nino(ninoId).consentimientos.usoImagen.autorizado == true
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    // QR de los medios de pago e imágenes de anuncios/eventos.
    match /publico/{archivo=**} {
      allow read: if autenticado();
      allow write: if esEntrenador();
    }
  }
}
