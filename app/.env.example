# Copia este archivo como app/.env.local cuando tengas un proyecto real de Firebase.
# Sin este archivo, la app usa los emuladores locales (modo de prueba, sin cuenta).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Clave web push (Firebase Console → Configuración → Cloud Messaging → Certificados web push)
VITE_FIREBASE_VAPID_KEY=
