# Copia este archivo como app/.env.local y pega tus claves de Supabase.
# Las encuentras en supabase.com -> tu proyecto -> Project Settings -> API (o "Connect").

# Dirección de tu proyecto. Se ve así: https://abcdefghij.supabase.co
VITE_SUPABASE_URL=

# Clave pública ("anon" o "publishable"). Es segura para ir en la app.
# NUNCA pegues aquí la clave secreta (service_role / secret).
VITE_SUPABASE_ANON_KEY=
